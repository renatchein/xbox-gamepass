	column 'Added Month' = DATE(YEAR(Games[Added]), MONTH(Games[Added]), 1)
		dataType: dateTime
		formatString: mmm d, yyyy
		lineageTag: e22e5095-5796-42d5-be09-b63f7ba56e5d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Removed Month' = IF(ISBLANK(Games[Removed]), BLANK(), DATE(YEAR(Games[Removed]), MONTH(Games[Removed]), 1))
		dataType: dateTime
		formatString: mmm d, yyyy
		lineageTag: d009c491-6fca-440a-8558-94ebb703a4bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Is Catalog Game' = Games[Status] <> "Coming Soon" && Games[Status] <> "Removed" && Games[Status] <> "GwG Permanent"
		dataType: boolean
		lineageTag: ea82b9bb-473b-4f40-8e1b-3c92dd78276a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Leaving Soon' = Games[Status] = "Leaving Soon"
		dataType: boolean
		lineageTag: 82c72d20-4630-44ab-a284-f9774ab4d414
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Metacritic Bucket' =
			SWITCH(
			    TRUE(),
			    ISBLANK(Games[Metacritic]), "Not Rated",
			    Games[Metacritic] >= 90, "90-100 - Must Play",
			    Games[Metacritic] >= 80, "80-89 - Great",
			    Games[Metacritic] >= 70, "70-79 - Good",
			    Games[Metacritic] >= 60, "60-69 - Mixed",
			    "Below 60"
			)
		dataType: string
		lineageTag: 51030b43-562a-4b34-8417-9d4b5b17e92d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Metacritic Bucket Order' =
			SWITCH(
			    TRUE(),
			    ISBLANK(Games[Metacritic]), 5,
			    Games[Metacritic] >= 90, 0,
			    Games[Metacritic] >= 80, 1,
			    Games[Metacritic] >= 70, 2,
			    Games[Metacritic] >= 60, 3,
			    4
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7348cbcf-b520-4120-845b-6f85489aecf6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duration Bucket' =
			SWITCH(
			    TRUE(),
			    ISBLANK(Games[CompletionHours]), "Unknown",
			    Games[CompletionHours] <= 5, "Quick (under 5h)",
			    Games[CompletionHours] <= 15, "Short (5-15h)",
			    Games[CompletionHours] <= 30, "Medium (15-30h)",
			    Games[CompletionHours] <= 60, "Long (30-60h)",
			    "Epic (60h+)"
			)
		dataType: string
		lineageTag: 9dce1a78-495f-4811-8141-f7da4fcdb0e2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Duration Bucket Order' =
			SWITCH(
			    TRUE(),
			    ISBLANK(Games[CompletionHours]), 6,
			    Games[CompletionHours] <= 5, 0,
			    Games[CompletionHours] <= 15, 1,
			    Games[CompletionHours] <= 30, 2,
			    Games[CompletionHours] <= 60, 3,
			    4
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ab2c4dbd-e32b-4438-bf2b-9149e96ff958
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ESRB Group' = IF(ISBLANK(Games[ESRB]) || Games[ESRB] = "" || Games[ESRB] = "RP", "Not Rated", Games[ESRB])
		dataType: string
		lineageTag: ec54e984-1a03-4f01-bc82-19b32135194d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

